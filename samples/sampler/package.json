{
  "name": "agate-sampler",
  "version": "3.2.0",
  "description": "Component and QA samples for Agate",
  "private": true,
  "main": "index.js",
  "scripts": {
    "bootstrap": "enact bootstrap",
    "clean": "enact clean",
    "cleanall": "enact clean --all",
    "lint": "enact lint --strict",
    "test": "echo \"No test suite\" && exit 0",
    "pack": "storybook build -c .storybook -o dist",
    "pack-qa": "storybook build -c .qa-storybook -o dist",
    "serve": "storybook dev -p 8080 -c .storybook --ci",
    "serve-qa": "storybook dev -p 8080 -c .qa-storybook --ci",
    "postinstall": "patch-package"
  },
  "license": "Apache-2.0",
  "enact": {
    "theme": "agate"
  },
  "dependencies": {
    "@enact/agate": "../../",
    "@enact/core": "^5.6.0",
    "@enact/i18n": "^5.6.0",
    "@enact/spotlight": "^5.6.0",
    "@enact/storybook-utils": "^8.0.3",
    "@enact/ui": "^5.6.0",
    "@github-ui/storybook-addon-performance-panel": "^1.1.4",
    "@storybook/react-webpack5": "^10.5.10",
    "dotenv": "^17.4.2",
    "ilib": "^14.22.0",
    "patch-package": "^8.0.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "storybook": "^10.5.10",
    "storybook-addon-pseudo-states": "^10.5.10"
  }
}
